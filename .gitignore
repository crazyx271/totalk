# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.output/
/outputs/
/work/
/desktop/node_modules/
/desktop/release/
/mobile/node_modules/
/mobile/android/app/google-services.json
/mobile/android/*.jks
/mobile/android/*.keystore
/mobile/ios/AuthKey_*.p8
/mobile/ios/*.mobileprovision

# local sqlite database and uploaded user content
/data/*.sqlite*
/data/avatars/
/data/message-files/
/data/downloads/
!/data/.gitkeep
