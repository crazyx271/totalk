{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totalk",
  "main": "dist/server/index.js",
  "assets": {
    "directory": "dist/client"
  },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_URL": "https://app.totalk.example",
    "TURN_URLS": "turn:turn.totalk.example:3478?transport=udp,turn:turn.totalk.example:3478?transport=tcp",
    "TURN_TTL_SECONDS": "3600"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "totalk-prod",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}